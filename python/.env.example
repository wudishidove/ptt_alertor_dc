# Discord Bot Token (Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_bot_token_here

# Admin backend Basic Auth
AUTH_USER=admin
AUTH_PW=change_me

# Web server bind
WEB_HOST=127.0.0.1
WEB_PORT=9090

# Optional: high-priority boards (comma separated, faster polling)
BOARD_HIGH=Gossiping,Beauty
